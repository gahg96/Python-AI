generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. Customers: 客户 (扩展版)
model Customer {
  id           String   @id @default(uuid())
  companyName  String   @map("company_name")
  industry     String?  // 行业
  companySize  String?  @map("company_size") // 规模
  city         String?  // 城市
  country      String?  // 国家
  contactName  String?  @map("contact_name")
  contactTitle String?  @map("contact_title") // 联系人职位
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")

  opportunities Opportunity[]

  @@map("customers")
}

// 2. Opportunities: 商机 (企业版)
model Opportunity {
  id                String   @id @default(uuid())
  opportunityNumber String?  @unique @map("opportunity_number") // 商机编号 OPP-YYYY-NNNN
  customerId        String   @map("customer_id")
  title             String
  status            OpportunityStatus @default(New)
  estimatedValue    Decimal? @map("estimated_value")
  probability       Int?     @default(0)
  source            String?
  expectedCloseDate DateTime? @map("expected_close_date")
  
  // Phase 5: Enterprise Fields
  salesStage        String?  @map("sales_stage")      // 销售阶段
  competitors       String?                           // 竞争对手
  decisionMakers    String?  @map("decision_makers")  // 决策链/关键人
  salesOwner        String?  @map("sales_owner")      // 销售负责人
  dealType          String?  @map("deal_type")        // 项目类型
  deliveryModel     String?  @map("delivery_model")   // 交付模式
  estimatedEffort   Int?     @map("estimated_effort") // 预计人天
  richDescription   String?  @map("rich_description") // 富文本描述 (HTML)
  
  // Phase 6: Financial Fields 财务字段
  projectBudget     Decimal? @map("project_budget")   // 客户预算
  businessCost      Decimal? @map("business_cost")    // 商务费用
  laborCost         Decimal? @map("labor_cost")       // 人力成本
  otherCost         Decimal? @map("other_cost")       // 其他成本
  grossProfit       Decimal? @map("gross_profit")     // 毛利润
  profitMargin      Decimal? @map("profit_margin")    // 毛利率(%)
  
  createdAt         DateTime @default(now()) @map("created_at")

  customer     Customer      @relation(fields: [customerId], references: [id])
  contracts    Contract[]
  followUps    FollowUp[]
  attachments  Attachment[]
  procurements Procurement[]

  @@map("opportunities")
}

enum OpportunityStatus {
  New
  Proposal
  Negotiation
  Won
  Lost
}

// 3. Contracts: 合同
model Contract {
  id                 String   @id @default(uuid())
  contractNumber     String   @unique @map("contract_number") // 合同编号
  opportunityId      String   @map("opportunity_id")
  
  status             ContractStatus @default(Draft)
  totalContractValue Decimal  @map("total_contract_value")
  paymentTerms       String?  @map("payment_terms")       // 付款条款概要
  
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  
  // 风险与审批
  riskAssessment     String?  @map("risk_assessment")     // 风险评估
  
  // IT Project Fields
  scope               String?
  sla                 String?
  liability           String?
  paymentTermsDetails String?  @map("payment_terms_details")

  drafterId          String?  @map("drafter_id")          // 拟稿人
  approverId         String?  @map("approver_id")         // 审批人
  
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  drafter     User?       @relation("ContractDrafter", fields: [drafterId], references: [id])
  approver    User?       @relation("ContractApprover", fields: [approverId], references: [id])
  milestones  Milestone[]
  documents   ContractDocument[]
  project     Project?
  invoices    Invoice[]

  @@map("contracts")
}

// 12. ContractDocument: 合同附件
model ContractDocument {
  id            String   @id @default(uuid())
  contractId    String   @map("contract_id")
  filename      String
  filepath      String
  mimetype      String
  size          Int
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])

  @@map("contract_documents")
}



// 4. Milestones: 里程碑 (项目执行+收款)
model Milestone {
  id         String   @id @default(uuid())
  contractId String   @map("contract_id")
  name       String
  amount     Decimal
  status     MilestoneStatus @default(Pending)
  dueDate    DateTime? @map("due_date")
  
  // 执行与回款记录
  acceptanceDate DateTime? @map("acceptance_date") // 验收日期
  acceptanceNote String?   @map("acceptance_note") // 验收说明
  invoiceDate    DateTime? @map("invoice_date")    // 开票日期
  paymentDate    DateTime? @map("payment_date")    // 回款日期
  
  createdAt  DateTime @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id])
  invoice  Invoice?

  @@map("milestones")
}

enum MilestoneStatus {
  Pending
  WIP // Work In Progress
  Completed        // 已完成
  Verified         // 已验收
  Ready_to_Invoice // 待开票
  Invoiced         // 已开票
  Paid             // 已收款
}

// 5. FollowUp: 跟进记录
model FollowUp {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  content       String   // 富文本内容 (HTML)
  createdBy     String?  @map("created_by") // Legacy: Store name directly
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [createdById], references: [id])

  @@map("follow_ups")
}

// 6. Attachment: 附件
model Attachment {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  filename      String
  filepath      String   // 服务器存储路径
  mimetype      String
  size          Int
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// 7. Procurement: 投标记录
model Procurement {
  id                  String   @id @default(uuid())
  procurementNumber   String   @unique @map("procurement_number") // 投标编号 BID-YYYY-NNNN
  opportunityId       String   @map("opportunity_id")
  
  type                ProcurementType // 投标类型
  status              ProcurementStatus @default(Draft)
  
  // 团队分工
  commercialOwner     String?  @map("commercial_owner")   // 商务负责人
  technicalOwner      String?  @map("technical_owner")    // 技术负责人
  
  customerBudget      Decimal? @map("customer_budget")    // 客户预算
  ourQuote            Decimal? @map("our_quote")          // 我方报价
  submissionDeadline  DateTime? @map("submission_deadline") // 提交截止日期
  notificationDate    DateTime? @map("notification_date")   // 通知日期/开标日期
  bidLocation         String?  @map("bid_location")       // 开标地点
  depositAmount       Decimal? @map("deposit_amount")     // 投标保证金
  notes               String?                             // 备注
  resultNote          String?  @map("result_note")        // 结果说明
  
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  documents           ProcurementDocument[]
  tasks               BiddingTask[]

  @@map("procurements")
}

// 8. BiddingTask: 投标材料任务
model BiddingTask {
  id            String   @id @default(uuid())
  procurementId String   @map("procurement_id")
  
  name          String                    // 任务名称：技术方案、商务报价等
  category      String   @default("other") // 分类: technical / commercial / qualification
  isCompleted   Boolean  @default(false)  @map("is_completed")
  assignee      String?                   // 负责人
  
  // 关联文件
  documentId    String?  @map("document_id")
  
  sortOrder     Int      @default(0)      @map("sort_order")
  createdAt     DateTime @default(now())  @map("created_at")
  
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  
  @@map("bidding_tasks")
}

enum ProcurementType {
  DirectQuote       // 单一来源/直接报价
  Negotiation       // 商务谈判
  Comparison        // 比选
  Consultation      // 磋商
  PublicTender      // 公开招标
}

enum ProcurementStatus {
  Draft             // 草稿
  Preparing         // 准备中
  Submitted         // 已提交
  InProgress        // 进行中 (评审中)
  Won               // 中标
  Lost              // 未中标
}

// 8. ProcurementDocument: 采购文档
model ProcurementDocument {
  id            String   @id @default(uuid())
  procurementId String   @map("procurement_id")
  docType       String   @map("doc_type")   // quote / technical / commercial / qualification / response
  filename      String
  filepath      String
  mimetype      String
  size          Int
  
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id])

  @@map("procurement_documents")
}

// 9. Users: 用户体系
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(SALES)
  email        String?
  createdAt    DateTime @default(now()) @map("created_at")

  createdFollowUps FollowUp[]
  uploadedDocs     ProcurementDocument[]
  auditLogs        AuditLog[]
  draftedContracts Contract[] @relation("ContractDrafter")
  approvedContracts Contract[] @relation("ContractApprover")
  contractDocuments ContractDocument[]
  projectResources  ProjectResource[]

  @@map("users")
}

enum UserRole {
  ADMIN
  SALES
  PRE_SALES
  COMMERCIAL // 商务
  TECHNICAL  // 技术
  MANAGER    // 经理 (审批)
  DEVELOPER
  USER
}

// 10. AuditLog: 审计日志
model AuditLog {
  id        String   @id @default(uuid())
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  action    String   // CREATE, UPDATE, DELETE
  userId    String?  @map("user_id")
  details   String?  // JSON string: { "field": { "old": "val", "new": "val" } }
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum ContractStatus {
  Draft             // 草稿
  PendingApproval   // 待审批
  Approved          // 已批准
  Rejected          // 已驳回
  Signed            // 已签署 (执行中)
  Terminated        // 已终止
}

// 11. Project: 项目执行
model Project {
  id                 String   @id @default(uuid())
  contractId         String   @unique @map("contract_id")
  status             ProjectStatus @default(Initialization)
  
  budget             Decimal?  @default(0)
  targetProfitMargin Decimal?  @map("target_profit_margin") // 预期利润率
  
  // Costs for profit calculation
  laborCost          Decimal?  @default(0) @map("labor_cost")
  outsourceCost      Decimal?  @default(0) @map("outsource_cost")
  travelCost         Decimal?  @default(0) @map("travel_cost")
  emergencySupportCost Decimal? @default(0) @map("emergency_support_cost")
  thirdPartyEquipmentCost Decimal? @default(0) @map("third_party_equipment_cost")
  softwareCost       Decimal?  @default(0) @map("software_cost")
  otherWeight        Decimal?  @default(0) @map("other_weight")
  
  complexity         ProjectComplexity @default(Low)
  financialRemarks   String?   @map("financial_remarks")
  
  isDelayed          Boolean   @default(false) @map("is_delayed")
  
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("endDate")
  description        String?
  
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contract  Contract @relation(fields: [contractId], references: [id])
  resources ProjectResource[]
  meetings  ProjectMeeting[]
  risks     ProjectRisk[]
  invoices  Invoice[]

  @@map("projects")
}

enum ProjectComplexity {
  Low
  Medium
  High
}

enum ProjectStatus {
  Initialization  // 启动中
  Planning        // 规划中
  Execution       // 实施中
  Delivery        // 交付中
  Maintenance     // 运维中
  Closed          // 已结项
}

model ProjectResource {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  userId        String   @map("user_id")
  role          String   // PM, Architect, Developer, Tester, etc.
  allocationPct Int      @default(100) @map("allocation_pct") // 投入比例
  
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("project_resources")
}

model ProjectMeeting {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  title         String
  type          ProjectMeetingType @default(Weekly)
  planDate      DateTime @map("plan_date")
  actualDate    DateTime? @map("actual_date")
  minutes       String?  // Markdown/RichText minutes content
  
  // File attachments for minutes
  filepath      String?
  filename      String?
  mimetype      String?
  
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_meetings")
}

enum ProjectMeetingType {
  Kickoff
  Weekly
  Monthly
  Technical
  Review
  Adhoc
}

model ProjectRisk {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  description   String
  impact        ProjectRiskImpact @default(Medium)
  status        ProjectRiskStatus @default(Open)
  mitigationPlan String? @map("mitigation_plan")
  
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_risks")
}

enum ProjectRiskImpact {
  Low
  Medium
  High
  Critical
}

enum ProjectRiskStatus {
  Open
  InMitigation
  Closed
  Occurred
}
// Finance Models - Invoice, Payment, MilestoneTemplate

model Invoice {
  id                String   @id @default(uuid())
  invoiceNumber     String   @unique @map("invoice_number")  // RM-2024-00001
  contractId        String   @map("contract_id")
  projectId         String?  @map("project_id")
  milestoneId       String?  @unique @map("milestone_id")
  
  // Invoice Details
  invoiceDate       DateTime @map("invoice_date")
  dueDate           DateTime @map("due_date")
  amount            Float
  taxRate           Float    @map("tax_rate")  // 0.06 or 0.13
  taxAmount         Float    @map("tax_amount")
  totalAmount       Float    @map("total_amount")
  
  // Type and Status
  type              InvoiceType
  status            InvoiceStatus @default(Draft)
  
  // Currency (extensible)
  currency          String   @default("RMB")
  exchangeRate      Float?   @map("exchange_rate")
  
  // Description
  description       String?
  remarks           String?
  
  // Receipt Attachment
  filePath          String?  @map("file_path")
  fileName          String?  @map("file_name")
  
  // Relations
  contract          Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone         Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  payments          Payment[]
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@map("invoices")
}

enum InvoiceType {
  Service   // 服务 6%
  Product   // 产品 13%
}

enum InvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Overdue
  Cancelled
}

model Payment {
  id              String   @id @default(uuid())
  paymentNumber   String   @unique @map("payment_number")
  invoiceId       String   @map("invoice_id")
  
  // Payment Details
  paymentDate     DateTime @map("payment_date")
  amount          Float
  currency        String   @default("RMB")
  
  // Payment Method
  paymentMethod   PaymentMethod @map("payment_method")
  bankName        String?  @map("bank_name")
  transactionRef  String?  @map("transaction_ref")
  
  // Status
  status          PaymentStatus @default(Confirmed)
  remarks         String?
  
  // Relations
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("payments")
}

enum PaymentMethod {
  BankTransfer
  Check
  Cash
  Other
}

enum PaymentStatus {
  Confirmed
  Reconciled
}

model MilestoneTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  // Milestone configuration as JSON
  milestones  String   // JSON array of milestone definitions
  
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("milestone_templates")
}
